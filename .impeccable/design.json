      "css": ".ds-tabs{display:flex;flex-direction:column;gap:3px;width:220px}.ds-tabs button{background:none;border:0;border-radius:4px;color:var(--muted,#657184);font:12px Arial,Helvetica,sans-serif;text-align:left;padding:9px 11px;cursor:pointer}.ds-tabs button[aria-current]{background:#eaf2fd;color:#215fae;font-weight:bold}.ds-tabs button:hover{background:#f0f5fc;color:#215fae}.ds-tabs button:focus-visible{outline:2px solid var(--blue,#2876d6);outline-offset:4px}"
